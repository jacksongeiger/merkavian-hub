# ─────────────────────────────────────────────────────────────────────────────
# Merkavian Hub — environment configuration
# Copy this file to .env and fill in real values. NEVER commit .env.
# ─────────────────────────────────────────────────────────────────────────────

# ─── Server (where Hub will bind on ARM) ─────────────────────────────────────
PORT=3002
HOST=127.0.0.1

# ─── ARM service endpoints (server-side proxy targets) ───────────────────────
# These are queried from Hub's API routes only. They must NEVER be exposed
# to the browser. cryptobot and polybot have no auth — safe only because
# they're localhost-only on ARM.
CRYPTOBOT_URL=http://127.0.0.1:5050
POLYBOT_URL=http://127.0.0.1:5001

# Optional fetch timeout in ms (CLAUDE.md says treat as down after 5s)
SERVICE_FETCH_TIMEOUT_MS=5000

# ─── Public service URLs (for iframe embedding via Caddy) ────────────────────
NEXT_PUBLIC_CRYPTO_TRACKER_URL=https://192-18-128-170.nip.io
NEXT_PUBLIC_RAPID_DRAFTER_URL=https://rapid-drafter.192-18-128-170.nip.io

# ─── rapid-drafter basic_auth (only if iframing through the auth'd domain) ───
# Leave blank if instead you add a separate un-auth'd internal Caddy route.
# Document chosen approach in CHANGELOG.md.
RAPID_DRAFTER_BASIC_USER=
RAPID_DRAFTER_BASIC_PASS=
